# WorldTradeStandard — Environment Variables
# Copy this to .env on your local machine (never commit .env)
# Set all of these as Environment Variables in your Render dashboard

# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Firebase Admin ─────────────────────────────────────────
# Paste the full contents of your Firebase service account JSON as a single-line string
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"worldtradestandard",...}

# ── NowPayments ────────────────────────────────────────────
# Dashboard → Store Settings → API Keys
NOWPAYMENTS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard → Store Settings → IPN Secret (for webhook signature verification)
NOWPAYMENTS_IPN_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WTS Internal Key ───────────────────────────────────────
WTS_INST_KEY=WTS_INST_2025_X9K

# ── Email — Resend ─────────────────────────────────────────
# resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Weekly email cron secret ───────────────────────────────
# Any long random string. Set the same value in cron-job.org as the x-cron-secret header.
# Schedule: POST https://api.worldtradestandard.com/api/email/weekly every Sunday at 08:00 UTC
CRON_SECRET=wts-cron-secret-change-me

# ── WTS Nexus Agent ────────────────────────────────────────
# Firebase UID allowed to call /api/admin/agent/* and /api/admin/vps/* endpoints
ADMIN_UID=

# ── Hetzner Cloud (VPS auto-provisioning) ───────────────────
# console.hetzner.cloud → Security → API Tokens (Read & Write)
HETZNER_API_TOKEN=
# Snapshot ID of the pre-configured WTS Nexus Agent image (Hetzner console → Snapshots)
HETZNER_SNAPSHOT_ID=
HETZNER_SERVER_TYPE=cx22
HETZNER_LOCATION=nbg1

# ── Bachs Payment ────────────────────────────────────────────
# Shared secret for verifying the x-bachs-secret webhook header, once Bachs confirms their scheme
BACHS_WEBHOOK_SECRET=

# ── Telegram notifications (optional) ────────────────────────
# BotFather → /newbot → token. No-op until users have a telegram_chat_id on file.
TELEGRAM_BOT_TOKEN=

# ── Server ─────────────────────────────────────────────────
PORT=3000
